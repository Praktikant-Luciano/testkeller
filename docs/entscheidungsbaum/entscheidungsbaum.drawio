<mxfile host="tools/entscheidungsbaum.py"><diagram id="pdok" name="Dokucheckliste PDok v3"><mxGraphModel dx="1150" dy="2450" grid="1" gridSize="10" page="1" pageWidth="1150" pageHeight="2450" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titel" value="Prozessdiagramm Dokucheckliste PDok · Stand v3 (Nutzer)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#6E6F70;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="125.0" y="10.0" width="900" height="40" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Anfrage zur Aushebung der PDok&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#94BF05;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="270.0" y="75.0" width="300" height="50" as="geometry"/></mxCell><mxCell id="q1" value="&lt;b&gt;Frage 1&lt;/b&gt;&lt;br&gt;Anfrage berechtigt?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#F6F4EA;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290.0" y="160.0" width="260" height="120" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;ABBRUCH&lt;/b&gt;&lt;br&gt;Auf Antwort des Anfragegebers warten&lt;br&gt;bzw. Rücksprache mit DL/MM" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fillColor=#6E6F70;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680.0" y="185.0" width="280" height="70" as="geometry"/></mxCell><mxCell id="q2" value="&lt;b&gt;Frage 2&lt;/b&gt;&lt;br&gt;Betrifft die Anfrage ganz oder&lt;br&gt;teilweise UKS Campus LKH&lt;br&gt;und/oder Campus CDK?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#F6F4EA;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290.0" y="330.0" width="260" height="120" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;ABBRUCH&lt;/b&gt;&lt;br&gt;Stabstelle Pflegeinformatik&lt;br&gt;des UKS ist nicht zuständig" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fillColor=#6E6F70;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680.0" y="360.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="p3a" value="Frage 3 · Ordner anlegen unter&lt;br&gt;G:\…\Beschwerden_Schadensfälle\test cp&lt;br&gt;Ordnername eingeben (Pflicht)&lt;br&gt;→ „Erledigt“" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260.0" y="500.0" width="320" height="90" as="geometry"/></mxCell><mxCell id="doc" value="Abschlussbericht.txt&lt;br&gt;wird im Ordner angelegt" style="shape=document;boundedLbl=1;size=0.2;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#94BF05;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700.0" y="513.0" width="240" height="64" as="geometry"/></mxCell><mxCell id="p3b" value="Ticket als Störung anlegen und&lt;br&gt;sich selbst zuweisen&lt;br&gt;Ticketnummer eingeben (Pflicht) → „Erledigt“" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260.0" y="632.0" width="320" height="76" as="geometry"/></mxCell><mxCell id="p4a" value="Frage 4 · Teilschritt 1&lt;br&gt;Anzahl Fälle (0–5) und Zeiträume (0–5)&lt;br&gt;→ „Weiter“ (gesperrt, wenn beide 0)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260.0" y="752.0" width="320" height="76" as="geometry"/></mxCell><mxCell id="p4b" value="Teilschritt 2 · je Fall: Fallnummer&lt;br&gt;je Zeitraum: TT.MM.JJJJ – TT.MM.JJJJ&lt;br&gt;→ „Fertig und weiter“" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260.0" y="872.0" width="320" height="76" as="geometry"/></mxCell><mxCell id="p4c" value="Teilschritt 3 · Was darf ausgehoben werden?&lt;br&gt;○ Komplette PDok des Umfangs&lt;br&gt;○ Teile des Umfangs (+ Freitext)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260.0" y="992.0" width="320" height="76" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;Frage 5&lt;/b&gt;&lt;br&gt;Welcher Fallstatus?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#F6F4EA;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290.0" y="1120.0" width="260" height="100" as="geometry"/></mxCell><mxCell id="t1" value="tree_1&lt;br&gt;Spalte „entlassen“" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30.0" y="1272.0" width="220" height="56" as="geometry"/></mxCell><mxCell id="t2" value="tree_2&lt;br&gt;Spalte „aktuell“" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="310.0" y="1272.0" width="220" height="56" as="geometry"/></mxCell><mxCell id="t3" value="tree_3 (tree_1 + tree_2)&lt;br&gt;„entlassen“ + „aktuell“" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580.0" y="1272.0" width="240" height="56" as="geometry"/></mxCell><mxCell id="p6" value="Frage 6 · Dokumentationssysteme wählen&lt;br&gt;MV5 · MV6 · NICE · U · Papier (Mehrfachwahl)&lt;br&gt;mind. 1 Haken → „Weiter“" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#FFFFFF;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250.0" y="1392.0" width="340" height="76" as="geometry"/></mxCell><mxCell id="q7" value="&lt;b&gt;Frage 7&lt;/b&gt;&lt;br&gt;Alle relevanten Dokumente&lt;br&gt;identifiziert (inkl.&lt;br&gt;Handsuche Hydmedia)?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#F6F4EA;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290.0" y="1540.0" width="260" height="120" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b&gt;Trotzdem&lt;/b&gt;&lt;br&gt;fortfahren?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#F6F4EA;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710.0" y="1550.0" width="220" height="100" as="geometry"/></mxCell><mxCell id="q8" value="&lt;b&gt;Frage 8&lt;/b&gt;&lt;br&gt;Alle Dokumente einer&lt;br&gt;Kategorie zugeordnet?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#F6F4EA;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290.0" y="1750.0" width="260" height="120" as="geometry"/></mxCell><mxCell id="t8" value="&lt;b&gt;Trotzdem&lt;/b&gt;&lt;br&gt;fortfahren?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fillColor=#F6F4EA;strokeColor=#6E6F70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710.0" y="1760.0" width="220" height="100" as="geometry"/></mxCell><mxCell id="kat" value="&lt;b&gt;Kategorien:&lt;/b&gt;&lt;br&gt;Pflegeanamnese&lt;br&gt;… (weitere tba)" style="rounded=1;arcSize=8;dashed=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#6E6F70;fil